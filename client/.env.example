# Foodable client env vars

# Optional: backend base URL (leave empty in dev to use vite proxy)
VITE_API_URL=

# Cognito Hosted UI — used by client/src/config/cognito.js to build the login URL.
#
# IMPORTANT: VITE_COGNITO_DOMAIN is the Hosted UI "Cognito domain" prefix you
# configure under: AWS Console -> User Pool -> App integration -> Domain.
# It is NOT the User Pool ID. By convention people often pick the lowercased
# pool ID with the underscore stripped, but it can be any globally-unique label.
VITE_COGNITO_DOMAIN=us-east-26myofkj3o
VITE_COGNITO_REGION=us-east-2
VITE_COGNITO_CLIENT_ID=7njedb56brgo2fokhnattr8lb1
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/loggedin
VITE_COGNITO_SCOPES=email+openid+phone
