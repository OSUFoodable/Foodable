# Foodable backend env vars

# Mongo connection string
MONGODB_URI=

# External service API keys
USDA_API_KEY=
OPENAI_API_KEY=

# Server
PORT=5050
NODE_ENV=development

# AWS Cognito
#   - USER_POOL_ID + CLIENT_ID + REGION are used by aws-jwt-verify
#     (server/src/auth/cognitoVerifier.js) to validate Bearer tokens.
#   - DOMAIN + CLIENT_SECRET are used by the /api/auth/exchange route
#     (server/src/routes/auth.js) to swap an authorization code for tokens.
#     CLIENT_SECRET stays server-side because the SPA cannot safely hold it.
#   - DOMAIN is the Hosted UI prefix from the App Integration > Domain section
#     (NOT the User Pool ID).
COGNITO_USER_POOL_ID=us-east-2_xxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_DOMAIN=us-east-2xxxxxxxx
COGNITO_REGION=us-east-2
